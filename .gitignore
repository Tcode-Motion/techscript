# TechScript 2.0 Root GitIgnore

# Rust & Cargo targets
target/
target_clippy/
Cargo.lock.lock
**/*.rs.bk

# Compiled TechScript binaries and packages
*.txc
public-release/
releases/current/
releases/latest/
releases/*.exe
releases/*.zip
releases/*.tar.gz

# Compiler Caches and Logs
build/
logs/
.tsc-cache/
.graphify-cache/

# OS Temporary Files
.DS_Store
Thumbs.db
*.tmp
*.temp

# IDEs & Editor Configuration Cache
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Node & Frontend dependencies (if any frontend builds exist)
node_modules/
dist/
out/
*.vsix
!editors/*.vsix

# Python Wrap Caches
__pycache__/
*.pyc
*.pyo
.pypy/
.pytest_cache/

# Local Environment Variables & Secrets
.env
.env.*
*.pem
*.key
*.cert
*.pfx
credentials.json
client_secret.json

# Local SQLite databases
*.db
local.db

# Releases directory
releases/

# Graphify Knowledge Graph
graphify-out/



# Executables & Binaries
*.exe
*.bin
*.out
*.app
bin/
build/
dist/
site/
