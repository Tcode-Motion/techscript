# ── TechScript v1.0.3 — Control Flow Fixes Demo ─────
# Run: tech run 16_control_flow_fix.txs
# This file demonstrates the bugs that were FIXED in v1.0.3

say "═══ Control Flow Fixes Demo ═══"
say ""

# ══════════════════════════════════════
# FIX 1: stop now works correctly
# (In v1.0.2, stop was compiled as return — completely wrong)
# ══════════════════════════════════════
say "▸ FIX: stop (break)"
make found = -1
each i in 1..100 {
    when i == 42 {
        found = i
        stop
    }
}
say f"  Found 42 in range 1..100: {found}"
say f"  (v1.0.2 would have crashed or returned from function)"

say ""

# ══════════════════════════════════════
# FIX 2: continue (skip) now works
# ══════════════════════════════════════
say "▸ FIX: continue (skip)"
make evens = []
each i in 1..20 {
    when i % 2 != 0 {
        skip
    }
    evens = evens + [i]
}
say f"  Even numbers 1..20: {evens}"

say ""

# ══════════════════════════════════════
# FIX 3: 'in' operator works properly
# (In v1.0.2, 'in' was compiled as 'equal' — wrong)
# ══════════════════════════════════════
say "▸ FIX: in operator"
make fruits = ["apple", "banana", "mango"]
say f"  'banana' in {fruits}: {'banana' in fruits}"
say f"  'grape'  in {fruits}: {'grape' in fruits}"

make info = {"name": "Tanmoy", "lang": "TechScript"}
say f"  'name' in map:  {'name' in info}"
say f"  'age'  in map:  {'age' in info}"

say f"  'Script' in 'TechScript': {'Script' in 'TechScript'}"

say ""

# ══════════════════════════════════════
# FIX 4: typeof returns real type
# (In v1.0.2, typeof always returned "unknown")
# ══════════════════════════════════════
say "▸ FIX: typeof"
say f"  typeof(42)        = {typeof(42)}"
say f"  typeof(3.14)      = {typeof(3.14)}"
say f"  typeof('hello')   = {typeof('hello')}"
say f"  typeof(true)      = {typeof(true)}"
say f"  typeof([1,2])     = {typeof([1,2])}"
say f"  typeof(none)      = {typeof(none)}"

say ""
say "All fixes verified! ✅"
