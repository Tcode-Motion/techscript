{
  "Function Declaration": {
    "prefix": "build",
    "body": [
      "build ${1:name}(${2:params}) {",
      "    $0",
      "}"
    ],
    "description": "Declare a function"
  },
  "Variable Declaration": {
    "prefix": "make",
    "body": [
      "make ${1:name} = ${2:value}"
    ],
    "description": "Declare a mutable variable"
  },
  "Constant Declaration": {
    "prefix": "const",
    "body": [
      "const ${1:name} = ${2:value}"
    ],
    "description": "Declare an immutable constant"
  },
  "Model Declaration": {
    "prefix": "model",
    "body": [
      "model ${1:Name} {",
      "    make ${2:field} = ${3:value}",
      "",
      "    build init(${2:field}) {",
      "        self.${2:field} = ${2:field}",
      "    }",
      "}"
    ],
    "description": "Declare a model/class structure"
  },
  "Condition Block": {
    "prefix": "when",
    "body": [
      "when ${1:condition} {",
      "    $2",
      "} else {",
      "    $3",
      "}"
    ],
    "description": "Conditional code execution block"
  },
  "If Block": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $2",
      "}"
    ],
    "description": "Conditional execution block"
  },
  "Each Loop": {
    "prefix": "each",
    "body": [
      "each ${1:item} in ${2:collection} {",
      "    $0",
      "}"
    ],
    "description": "Loop over a collection"
  },
  "Repeat Loop": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:times} {",
      "    $0",
      "}"
    ],
    "description": "Repeat execution block"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "While loop block"
  },
  "Attempt Catch Block": {
    "prefix": "attempt",
    "body": [
      "attempt {",
      "    $1",
      "} catch ${2:error} {",
      "    $0",
      "}"
    ],
    "description": "Try-catch exception handling block"
  },
  "Say Print Statement": {
    "prefix": "say",
    "body": [
      "say ${1:expression}"
    ],
    "description": "Print to stdout"
  },
  "Ask Input Expression": {
    "prefix": "ask",
    "body": [
      "ask ${1:prompt}"
    ],
    "description": "Read from stdin"
  },
  "Main Function Entry": {
    "prefix": "main",
    "body": [
      "build main() {",
      "    $0",
      "    return 0",
      "}"
    ],
    "description": "Main entry point function"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:Variant1},",
      "    ${3:Variant2}",
      "}"
    ],
    "description": "Declare an enumeration"
  },
  "Trait Declaration": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "    build ${2:method}(${3:params})",
      "}"
    ],
    "description": "Declare a trait interface"
  },
  "Module Declaration": {
    "prefix": "module",
    "body": [
      "import ${1:Symbol} from \"${2:module}\""
    ],
    "description": "Import a module or library"
  },
  "Package Config": {
    "prefix": "package",
    "body": [
      "package {",
      "    name = \"${1:project}\",",
      "    version = \"1.0.0\",",
      "    entry = \"main.txs\"",
      "}"
    ],
    "description": "TechScript package descriptor"
  },
  "Test Declaration": {
    "prefix": "test",
    "body": [
      "#[test]",
      "build test_${1:name}() {",
      "    $0",
      "}"
    ],
    "description": "Declare a test function"
  }
}
