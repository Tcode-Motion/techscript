say "=== Control Flow ==="

# If / Else If / Else
make score = 85

when score >= 90 {
    say "Grade: A"
} or when score >= 80 {
    say "Grade: B"
} or when score >= 70 {
    say "Grade: C"
} else {
    say "Grade: F"
}

# Unless
unless score == 100 {
    say "You didn't get a perfect score."
}

# Range and Each
say "- Counting 1 to 5:"
each i in 1..=5 {
    say i
}

# Repeat (While) loop
say "- Repeat loop:"
make count = 3
repeat count > 0 {
    say "Countdown:", count
    count -= 1
}

# Until loop
say "- Until loop:"
make x = 0
until x == 3 {
    say "x is", x
    x += 1
}

# Match statement
make day = 3
say f"Day {day} is:"
match day {
    case 1 { say "Monday" }
    case 2 { say "Tuesday" }
    case 3 { say "Wednesday" }
    case 4 { say "Thursday" }
    case 5 { say "Friday" }
    case 6 { say "Saturday" }
    case 7 { say "Sunday" }
}
