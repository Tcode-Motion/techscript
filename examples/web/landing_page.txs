# TechScript Landing Page — DSL Block Syntax
# Run: tsc run examples/web/landing_page.txs
# Generates HTML from DSL blocks using std.web.render_html()
# Open the generated landing_page.html in a browser

use web

# Build the entire landing page with DSL blocks
# Each block declaratively defines HTML structure
website
  title "TechScript 2.0"

  header
    title "TechScript"
    nav
      link
        label "Docs"
        url "/docs"
      end
      link
        label "GitHub"
        url "https://github.com"
      end
      link
        label "Examples"
        url "/examples"
      end
    end
  end

  hero
    title "TechScript"
    subtitle "A modern, expressive programming language. Fast, safe, built for real-world applications."
    start
      label "Get Started"
    end
    button
      label "View on GitHub"
    end
  end

  section
    title "Built-in Modules"
    id "features"

    card
      title "Web"
      text "HTTP server with routing, middleware, and static files."
    end

    card
      title "SQLite"
      text "Native database with prepared statements and migrations."
    end

    card
      title "Canvas"
      text "SVG-based graphics, image processing, and animations."
    end

    card
      title "Security"
      text "Crypto, hashing, random generation, and JWT support."
    end

    card
      title "Cache"
      text "In-memory cache with TTL, LRU eviction."
    end

    card
      title "Parallel"
      text "Multi-threaded execution and async support."
    end

    card
      title "Notifications"
      text "Desktop alerts and system tray integration."
    end

    card
      title "Debug"
      text "Inspect, trace, and benchmark your code."
    end
  end

  footer
    text "TechScript 2.0 — MIT License"
  end
end

# Generate HTML from all DSL blocks
make html = web.render_html()

# Save to file
make file = std.io.open("landing_page.html", "w")
file.write(html)
file.close()

std.io.println("Done! Saved landing_page.html — open in your browser.")
