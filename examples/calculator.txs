# TechScript Calculator
# A simple interactive calculator

say "=== TechScript Calculator ==="
say "Type 'quit' to exit"
say ""

repeat true {
    make input_line = ask "Calc> "

    when input_line == "quit" {
        say "Goodbye!"
        stop
    }

    make parts = input_line.split(" ")
    guard parts.length == 3 else {
        say "Usage: number operator number (e.g. 5 + 3)"
        skip
    }

    make a = to_float(parts[0])
    make op = parts[1]
    make b = to_float(parts[2])

    match op {
        case "+" { say f"= {a + b}" }
        case "-" { say f"= {a - b}" }
        case "*" { say f"= {a * b}" }
        case "/" {
            when b == 0 {
                say "Error: Cannot divide by zero!"
            } else {
                say f"= {a / b}"
            }
        }
        case "**" { say f"= {a ** b}" }
        case "%" { say f"= {a % b}" }
        case _ { say f"Unknown operator: {op}" }
    }
}
