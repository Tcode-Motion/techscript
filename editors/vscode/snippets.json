{
  "Function Definition": {
    "prefix": "to",
    "body": [
      "to ${1:name}(${2:parameters}):",
      "    $0"
    ],
    "description": "Define a canonical TechScript function"
  },
  "Function with Return": {
    "prefix": "toreturn",
    "body": [
      "to ${1:name}(${2:parameters}):",
      "    $0",
      "    return ${3:value}"
    ],
    "description": "Define a TechScript function with return statement"
  },
  "Variable Declaration": {
    "prefix": "is",
    "body": [
      "${1:name} is ${2:value}"
    ],
    "description": "Declare a new variable with 'is'"
  },
  "Variable Reassignment": {
    "prefix": "becomes",
    "body": [
      "${1:name} becomes ${2:value}"
    ],
    "description": "Reassign an existing variable with 'becomes'"
  },
  "Constant Declaration": {
    "prefix": "constant",
    "body": [
      "constant ${1:name} is ${2:value}"
    ],
    "description": "Declare an immutable constant"
  },
  "Print / Say": {
    "prefix": "say",
    "body": [
      "say \"${1:Message: {value}}\""
    ],
    "description": "Output string or interpolated text"
  },
  "If Conditional": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    $2",
      "else:",
      "    $0"
    ],
    "description": "If / Else conditional branch"
  },
  "If / Else If Conditional": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}:",
      "    $2",
      "else if ${3:other_condition}:",
      "    $4",
      "else:",
      "    $0"
    ],
    "description": "If / Else If / Else conditional branch"
  },
  "Counted Repetition Loop": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3} times:",
      "    $0"
    ],
    "description": "Repeat block N times"
  },
  "For Loop Iteration": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:collection}:",
      "    $0"
    ],
    "description": "Iterate across collections or arrays"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "    $0"
    ],
    "description": "Loop while condition evaluates to true"
  },
  "Try / Catch Error Boundary": {
    "prefix": "try",
    "body": [
      "try:",
      "    $1",
      "catch ${2:err}:",
      "    $0"
    ],
    "description": "Recoverable error boundary"
  },
  "Class Definition": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "    to init(${2:params}):",
      "        $0"
    ],
    "description": "Declare a class model with constructor"
  },
  "WebForge Web Page": {
    "prefix": "page",
    "body": [
      "page \"${1:/path}\":",
      "    title is \"${2:Page Title}\"",
      "    $0"
    ],
    "description": "WebForge declarative web route"
  },
  "AppForge Mobile Screen": {
    "prefix": "screen",
    "body": [
      "screen \"${1:home}\":",
      "    $0"
    ],
    "description": "AppForge mobile screen declaration"
  }
}
