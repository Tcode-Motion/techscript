{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TechScript",
  "scopeName": "source.techscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#literals" },
    { "include": "#dsl" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.techscript", "match": "#.*$" },
        { "name": "comment.line.double-slash.techscript", "match": "//.*$" },
        { "name": "comment.block.techscript", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "attributes": {
      "name": "entity.name.tag.attribute.techscript",
      "match": "#\\[[a-zA-Z_]+\\]"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.techscript",
          "match": "\\b(if|else|repeat|times|while|for|in|match|case|default|try|catch|throw|return|say|ask|async|await|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.techscript",
          "match": "\\b(to|is|becomes|constant|class|struct|enum|trait|interface|use|import|export|package|new)\\b"
        },
        {
          "name": "keyword.operator.techscript",
          "match": "(\\+|\\-|\\*|/|\\%|==|!=|<=|>=|<|>|&&|\\|\\||!|=)"
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.techscript", "match": "\\b(int|float|bool|str|list|map|any|void)\\b" },
        { "name": "entity.name.type.techscript", "match": "\\b[A-Z][a-zA-Z0-9_]*\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.techscript", "match": "(?<=to\\s+)[a-zA-Z_][a-zA-Z0-9_]*" },
        { "name": "entity.name.function.call.techscript", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.techscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.techscript", "match": "\\\\." },
            {
              "name": "meta.embedded.expression.techscript",
              "begin": "(?<!\\\\)\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#keywords" },
                { "include": "#functions" },
                { "include": "#numbers" },
                { "include": "#literals" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.techscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.techscript", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.techscript", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.techscript", "match": "\\b\\d+\\b" }
      ]
    },
    "literals": {
      "patterns": [
        { "name": "constant.language.boolean.techscript", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.null.techscript", "match": "\\b(null|none)\\b" },
        { "name": "variable.language.self.techscript", "match": "\\bself\\b" }
      ]
    },
    "dsl": {
      "patterns": [
        { "name": "entity.name.section.dsl.techscript", "match": "\\b(page|screen|widget|button|text|card|dock|row|column|spacer|database|table)\\b" }
      ]
    }
  }
}
