{
  "name": "techscript",
  "displayName": "TechScript Language",
  "description": "Syntax highlighting, snippets, file icons for TechScript (.txs) v1.0.5 — API, Web, GUI, 3D, Animation",
  "version": "1.0.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tcode-Motion/techscript"
  },
  "publisher": "tanmoy",
  "author": {
    "name": "Tanmoy (Tcode-Motion)",
    "url": "https://github.com/Tcode-Motion"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages", "Themes"],
  "icon": "icons/techscript-logo.png",
  "contributes": {
    "languages": [
      {
        "id": "techscript",
        "aliases": ["TechScript", "txs"],
        "extensions": [".txs", ".tx"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/techscript-file.png",
          "dark": "./icons/techscript-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "techscript",
        "scopeName": "source.techscript",
        "path": "./syntaxes/techscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "techscript",
        "path": "./snippets/techscript.json"
      }
    ]
  }
}
