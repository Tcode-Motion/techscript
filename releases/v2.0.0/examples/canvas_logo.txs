# TechScript Logo Design — DSL Block Syntax
# Run: tsc run examples/graphics/logo_design.txs
# Uses canvas DSL blocks to generate techscript_logo.svg

use fs
use canvas

# Build the TechScript logo from DSL blocks
# Each block becomes a DslBlockValue and is rendered to SVG
logo "TS"
  text "TechScript"
  color "#00d4ff"
  size 64
end

rings
  count 4
  color "#00d4ff"
  size 40
  thickness 3
end

emblem
  shape "diamond"
  color "#0088cc"
  size 120
end

core
  size 35
  color "#66e0ff"
end

core
  size 20
  color "#aaeeff"
end

letter "T"
  char "T"
  color "#0a0e27"
  size 28
end

circuits
  color "#00d4ff"
end

# Render all DSL blocks to SVG and save
svg_content = canvas.render_blocks()
fs.write_file("techscript_logo.svg", svg_content)

say "Done! Saved techscript_logo.svg"
