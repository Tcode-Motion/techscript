# compat/05_modules.txs — v1.0.8 module namespace access without import

# Direct namespace access (no import statement required)
make root be math.sqrt(16)
say root         # expected: 4.0

make rnd be math.round(3.7)
say rnd          # expected: 4

# random module namespace
# (seeding isn't supported, just verify callable)
# say random.randint(1, 10)   # should produce a number 1..10

# floor / ceil
say math.floor(2.9)    # expected: 2
say math.ceil(2.1)     # expected: 3

say math.abs(-7)       # expected: 7
say math.pow(2, 10)    # expected: 1024

# After explicit import the namespace still works
import math
say math.sqrt(25)      # expected: 5.0
