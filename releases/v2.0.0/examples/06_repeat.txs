# LEGACY COMPATIBILITY TEST
# This file intentionally uses deprecated TechScript syntax.
# It verifies backward compatibility.
# Expected: Successful compilation + TSW100x warnings.

# compat/06_repeat.txs — v1.0.8 repeat-while semantics
# 2.0: `repeat condition { body }` is a while-loop

make x be 1
repeat x <= 5 {
  say x
  x = x + 1
}
# expected output: 1 2 3 4 5

# stop (break) inside repeat
make i be 0
repeat i < 10 {
  if i equals 4 {
    stop
  }
  i = i + 1
}
say i        # expected: 4

# skip (continue) inside repeat
make j be 0
repeat j < 10 {
  j = j + 1
  if j % 2 equals 1 {
    skip
  }
  say j
}
# expected: 2 4 6 8 10
