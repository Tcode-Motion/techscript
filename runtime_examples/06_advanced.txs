say "=== Advanced Features ==="

# Error Handling: try / rescue / always
say "\n--- Try / Rescue / Always ---"
attempt {
    say "Trying to trigger an error..."
    make x = 10 / 0
    say "This line will not run."
} rescue e {
    # Note: detailed exceptions are standard but native exceptions are stubbed
    say "Caught an error!"
} always {
    say "Always block runs regardless of errors."
}

# Throwing custom errors
build risky_function(x) {
    when x < 0 {
        fail "Number must be positive!"
    }
    send x * 2
}

attempt {
    say "risky_function(5):", risky_function(5)
    say "risky_function(-2):", risky_function(-2)
} rescue err {
    say "Rescued validation error."
}

# Guard statement
say "\n--- Guard Statements ---"
build display_positive(num) {
    guard num > 0 else {
        say "Number is not positive, aborting!"
        send none
    }
    say f"The positive number is {num}"
}

display_positive(42)
display_positive(-5)

# With / As (Context Managers)
# Useful for File I/O once fs module is ready
say "\n--- With / As Statement ---"
say "with open('file.txt') as f { f.read() } is supported."

# Export
say "\n--- Modules ---"
say "share my_func will export a function."
