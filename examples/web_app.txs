# TechScript Web App Example

use web

state click_count = 0

api MyApi {
    route "/hello" {
        send { "message": "Hello from backend!" }
    }
}

component Header {
    render "header" {
        render "h1" {
            say "TechScript Web Module"
        }
    }
}

page Home {
    style {
        # A simple style object representation
        container = { "padding": "20px", "font-family": "sans-serif", "background": "#121212", "color": "#f0f0f0" }
        button_style = { "padding": "10px 20px", "background": "#007BFF", "color": "white", "border": "none", "border-radius": "5px" }
    }

    render "div" {
        render "Header" {}
        
        render "p" {
            say "Welcome to the future of web development with TechScript!"
        }
        
        render "button" {
            # In a real DOM this would bind an onClick event, but here it's just a representation
            say "Click me (Count: {click_count})"
        }
    }
}
