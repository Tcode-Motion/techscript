# 1. Headless Canvas Rendering
let canvas = std.graphics.create_canvas(200, 200);
std.graphics.draw_rect(canvas, 20, 20, 160, 160, "#57a587ff"); # Red-orange rectangle
std.graphics.draw_circle(canvas, 100, 100, 50, "#88ff00ff");    # Green circle
std.graphics.draw_line(canvas, 0, 0, 199, 199, "#008cffff");     # Blue diagonal line
std.graphics.save_png(canvas, "test_output.png");
std.io.println("✓ Headless canvas rendered and saved to test_output.png");

# 2. Cryptographic Hashing
let plain = "TechScript 2.0 Modern Stdlib";
let sha256_hash = std.hash.sha256(plain);
let md5_hash = std.hash.md5(plain);
let crc32_checksum = std.hash.crc32(plain);

std.io.println("SHA-256: " + sha256_hash);
std.io.println("MD5: " + md5_hash);
std.io.println("CRC-32: ");
std.io.println(crc32_checksum);

# 3. Authenticated AES Encryption
let key = "secure_key_123456";
let secret = "Top Secret TechScript Message";
let encrypted = std.crypto.aes_encrypt(key, secret);
let decrypted = std.crypto.aes_decrypt(key, encrypted);

std.io.println("AES Encrypted (Hex): " + encrypted);
std.io.println("AES Decrypted: " + decrypted);

# 4. AI Provider Text Generation
let ai_response = std.ai.generate_text("openai", "How do I build a compiler?", {});
std.io.println("AI Response: " + ai_response);