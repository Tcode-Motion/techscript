# TechScript Calculator
# A simple interactive calculator

say "=== TechScript Calculator ==="
say "Type 'quit' to exit"
say ""

while true:
    input_line = ask "Calc> "

    if input_line == "quit":
        say "Goodbye!"
        break

    parts = input_line.split(" ")
    guard parts.length == 3 else:
        say "Usage: number operator number (e.g. 5 + 3)"
        skip

    a = to_float(parts[0])
    op = parts[1]
    b = to_float(parts[2])

    match op:
        case "+":
            say f"= {a + b}"
        case "-":
            say f"= {a - b}"
        case "*":
            say f"= {a * b}"
        case "/":
            if b == 0:
                say "Error: Cannot divide by zero!"
            else:
                say f"= {a / b}"
        case "**":
            say f"= {a ** b}"
        case "%":
            say f"= {a % b}"
        case _:
            say f"Unknown operator: {op}"
