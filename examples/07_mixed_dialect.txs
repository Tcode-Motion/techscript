# LEGACY COMPATIBILITY TEST
# This file intentionally uses deprecated TechScript syntax.
# It verifies backward compatibility.
# Expected: Successful compilation + TSW100x warnings.

# compat/07_mixed_dialect.txs — mixing v1.0.8 and 2.0 syntax in one file
# Per spec: both dialects compile to the same bytecode; mixing is legal.

# 2.0-style variable declaration
let greeting = "Hello"

# v1.0.8-style constant
keep MAX be 100

# 2.0-style function
build add(a, b) {
  return a + b
}

# v1.0.8-style function
build multiply with a, b then
  give a * b
end

say add(3, 4)          # expected: 7
say multiply(3, 4)     # expected: 12

# 2.0-style if
if MAX > 50 {
  say "big"
}

# v1.0.8-style if
when MAX > 50 then
  say "also big"
end

# 2.0 for loop
for i in 0..2 {
  say i
}

# v1.0.8 for loop
each i in 0..2 then
  say i
end

# Nested: v1 function with 2.0 body
build check with val {
  if val > 0 {
    give "positive"
  }
  give "non-positive"
}

say check(5)     # expected: positive
say check(-1)    # expected: non-positive
