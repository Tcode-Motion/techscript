{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TechScript",
  "scopeName": "source.techscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#fstrings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.techscript",
          "begin": "#\\[",
          "end": "\\]#"
        },
        {
          "name": "comment.line.number-sign.techscript",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.techscript",
          "begin": "(\"\"\")|'''",
          "end": "(\"\"\")|'''"
        },
        {
          "name": "string.quoted.double.techscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.techscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.techscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.techscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "fstrings": {
      "patterns": [
        {
          "name": "string.interpolated.techscript",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.embedded.expression.techscript",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            },
            {
              "name": "constant.character.escape.techscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.techscript",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.techscript",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.techscript",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.techscript",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.techscript",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.techscript",
          "match": "\\b(if|elif|else|for|while|until|unless|match|case|try|catch|finally|throw|break|skip|pass|return|guard|with|do|defer|when|attempt|repeat)\\b"
        },
        {
          "name": "keyword.declaration.techscript",
          "match": "\\b(fn|build|class|model|set|make|const|keep|mut|del|global|export|import|use|from|as|new|send)\\b"
        },
        {
          "name": "keyword.operator.logical.techscript",
          "match": "\\b(and|or|not|is|has|in|typeof)\\b"
        },
        {
          "name": "keyword.other.techscript",
          "match": "\\b(say|ask|self|super|async|await|yield|each)\\b"
        },
        {
          "name": "support.class.module.techscript",
          "match": "\\b(api|web|gui|three_d|anime|debug|math|fs|os|random|json|crypto|date)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.techscript",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.techscript",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.none.techscript",
          "match": "\\bnone\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.techscript",
          "match": "\\b(abs|round|ceil|floor|min|max|sum|sqrt|pow|clamp|sign|len|size|range|enumerate|zip|sorted|reversed|map|filter|int|float|str|bool|list|type|to_int|to_float|to_str|to_bool|to_list|is_int|is_float|is_str|is_list|is_map|is_none|is_bool|is_even|is_odd|typeof|print|write|log|warn|error|clear|format|read_file|write_file|append_file|split|join|replace|replace_all|contains|starts_with|ends_with|upper|lower|trim|chars|repeat|reverse|find|sleep|exit|assert|panic|time|time_ms|version|callable|random_int)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.techscript",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.techscript",
          "match": "=>"
        },
        {
          "name": "keyword.operator.range.techscript",
          "match": "\\.\\.(=)?"
        },
        {
          "name": "keyword.operator.spread.techscript",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.techscript",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.techscript",
          "match": "(\\+=|-=|\\*=|/=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.techscript",
          "match": "(\\*\\*|\\+|-|\\*|//|/|%)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.techscript",
          "match": "(?<=(fn|build)\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.class.techscript",
          "match": "(?<=(class|model)\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.techscript",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
