{
  "name": "techscript",
  "displayName": "TechScript Language",
  "description": "Syntax highlighting, snippets, file icons, and web module support for TechScript (.txs). v2",
  "version": "1.0.7",
  "publisher": "tanmoy",
  "author": "Tanmoy Majumder",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tcode-Motion/techscript"
  },
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:techscript.run",
    "onCommand:techscript.repl",
    "onCommand:techscript.studio"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages", "Themes"],
  "icon": "icons/techscript-logo.png",
  "contributes": {
    "languages": [
      {
        "id": "techscript",
        "aliases": ["TechScript", "txs"],
        "extensions": [".txs", ".tx"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/techscript-file.png",
          "dark": "./icons/techscript-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "techscript",
        "scopeName": "source.techscript",
        "path": "./syntaxes/techscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "techscript",
        "path": "./snippets/techscript.json"
      }
    ],
    "commands": [
      {
        "command": "techscript.run",
        "title": "TechScript: Run Current File",
        "category": "TechScript"
      },
      {
        "command": "techscript.repl",
        "title": "TechScript: Open Interactive REPL",
        "category": "TechScript"
      },
      {
        "command": "techscript.studio",
        "title": "TechScript: Launch Studio IDE",
        "category": "TechScript"
      }
    ]
  }
}
