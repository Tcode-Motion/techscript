# ── TechScript v1.0.3 — Inline Eval Demo ─────────────
# This file itself is an example. But the REAL power is inline:
#
# ╔══════════════════════════════════════════════════════╗
# ║  NEW IN v1.0.3 — Run code WITHOUT a file!           ║
# ║                                                      ║
# ║  tech eval "say 42"                                  ║
# ║  tech eval "say crypto.sha256('hello')"              ║
# ║  tech eval "say math.factorial(20)"                  ║
# ║  tech eval "say date.now"                            ║
# ║  tech eval "say random.uuid"                         ║
# ╚══════════════════════════════════════════════════════╝
#
# You can also use the triple-bracket shorthand:
#   tech "[[[say 'Hello from inline!']]]"

say "═══ Inline Eval Demo ═══"
say ""
say "This file shows what you can do with tech eval."
say "Open your terminal and try these one-liners:"
say ""
say "  tech eval \"say 'Hello World'\""
say "  tech eval \"say 2 + 2\""
say "  tech eval \"say crypto.sha256('password')\""
say "  tech eval \"say math.PI\""
say "  tech eval \"say date.now\""
say "  tech eval \"say random.uuid\""
say "  tech eval \"say os.name\""
say ""
say "Quick one-liners without even needing a file! ⚡"
say ""
say "Done! ✅"
