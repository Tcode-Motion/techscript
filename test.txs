# test.txs
# TechScript 2.0 Quick Smoke Test Script
# Exercises representative features from basics and the standard library.

# 1. Basics: Variables & Loops
make count = 0;
while count < 2 {
    std.io.println("Smoke test loop index: " + std.strings.from_int(count));
    count = count + 1;
}

# 2. Stdlib: Math and String manipulation
make abs_val = std.math.abs(-100);
make upper_str = std.string.to_upper("techscript 2.0");
std.io.println("Absolute value: " + std.strings.from_int(abs_val));
std.io.println("Uppercase string: " + upper_str);

# 3. Stdlib: JSON parsing
make parsed = std.json.parse("{\"smoke_test\": \"passed\"}");
std.io.println("JSON parsed property: " + parsed.smoke_test);
