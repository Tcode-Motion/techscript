{
  "Function": {
    "prefix": "do",
    "body": ["do ${1:name}(${2:parameters})", "    $0", "end"],
    "description": "Declare a TechScript 2.0 function"
  },
  "Function with return value": {
    "prefix": "doreturn",
    "body": ["do ${1:name}(${2:parameters})", "    send ${3:value}", "end"],
    "description": "Declare a function that returns a value"
  },
  "Constant": {
    "prefix": "const",
    "body": ["const ${1:NAME} = ${2:value}"],
    "description": "Declare an immutable constant"
  },
  "Conditional": {
    "prefix": "when",
    "body": ["when ${1:condition}", "    $2", "else", "    $0", "end"],
    "description": "Create a when/else block"
  },
  "Counted loop": {
    "prefix": "loop",
    "body": ["loop ${1:count}", "    $0", "end"],
    "description": "Repeat a block a fixed number of times"
  },
  "Condition loop": {
    "prefix": "repeat",
    "body": ["repeat ${1:condition}", "    $0", "end"],
    "description": "Repeat while a condition is true"
  },
  "Collection loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items}", "    $0", "end"],
    "description": "Iterate over a collection"
  },
  "Error handling": {
    "prefix": "try",
    "body": ["try", "    $1", "catch ${2:error}", "    $0", "end"],
    "description": "Handle a recoverable error"
  },
  "Class": {
    "prefix": "class",
    "body": ["class ${1:Name}", "    $0", "end"],
    "description": "Declare a class"
  },
  "Constructor": {
    "prefix": "init",
    "body": ["do init(${1:parameters})", "    $0", "end"],
    "description": "Declare a class constructor"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name}", "    ${2:Variant}", "end"],
    "description": "Declare an enum"
  },
  "Trait": {
    "prefix": "trait",
    "body": ["trait ${1:Name}", "    $0", "end"],
    "description": "Declare a trait"
  },
  "Interface": {
    "prefix": "interface",
    "body": ["interface ${1:Name}", "    $0", "end"],
    "description": "Declare an interface"
  },
  "Import module": {
    "prefix": "use",
    "body": ["use ${1:module}"],
    "description": "Import a module"
  },
  "Interpolated string": {
    "prefix": "interp",
    "body": ["$\"${1:Hello, {name}}\""],
    "description": "Create an interpolated string"
  },
  "Test": {
    "prefix": "test",
    "body": ["do test_${1:name}()", "    $0", "end"],
    "description": "Create a test function"
  }
}
