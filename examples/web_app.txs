# TechScript Web — component + page + API (Rust runtime)

use web

state click_count = 0

api MyApi {
    route "/hello" {
        say "api ok"
    }
}

component Header {
    render "header" {
        render "h1" {
            say "TechScript Web"
        }
    }
}

page Home {
    render "div" {
        render "Header" {}
        render "p" {
            say "Welcome to TechScript"
        }
        render "button" {
            say "Click me"
        }
    }
}

__web_run_framework()
