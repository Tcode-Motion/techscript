# ==============================================================================
# TechScript AppForge: Native Android Application Activity
# Authored in 100% Pure TechScript (.txs)
# 
# Handles the complete Android Activity lifecycle, UI rendering, navigation dock,
# state management, theme switching, and platform system bridges.
# ==============================================================================

# Application Metadata
package_name = "com.techscript.appforge"
activity_name = "MainActivity"
engine_version = "2.0.0"

# Navigation Targets
NAV_HOME = "home"
NAV_PROJECTS = "workspace"
NAV_DOCS = "docs"
NAV_TOOLS = "diagnostics"
NAV_ABOUT = "about"

# ------------------------------------------------------------------------------
# Native Android Activity Definition
# ------------------------------------------------------------------------------
model MainActivity extends Activity:
    package_id = "com.techscript.appforge"
    title = "TechScript AppForge"
    version = "2.0.0"
    author = "Tanmoy Majumder"
    active_tab = "home"
    theme_mode = "system"
    is_dark = true
    is_initialized = false

    # --------------------------------------------------------------------------
    # Android OS Lifecycle Callbacks
    # --------------------------------------------------------------------------

    # Called when the activity is starting.
    do onCreate(saved_instance_state)
        say "[TechScript Activity] =========================================="
        say $"[TechScript Activity] Starting {self.title} (v{self.version})"
        say $"[TechScript Activity] Package ID: {self.package_id}"
        say $"[TechScript Activity] Developer: {self.author} (Tcode-Motion)"
        say "[TechScript Activity] =========================================="

        # Initialize state and restore previous instance state if available
        when saved_instance_state != none
            say "[TechScript Activity] Restoring saved instance state..."
        end

        # Establish default system theme
        self.theme_mode = "system"
        self.is_dark = true
        self.active_tab = "home"

        # Construct and mount native UI tree
        self.mount_application_ui()
        self.is_initialized = true
        say "[TechScript Activity] Activity initialization completed successfully."
    end

    # Called when the activity will start interacting with the user.
    do onResume()
        say "[TechScript Activity] onResume: Activity gained interactive focus."
    end

    # Called when the system is about to start resuming a previous activity.
    do onPause()
        say "[TechScript Activity] onPause: Activity state preserved."
    end

    # Called when the activity is no longer visible to the user.
    do onStop()
        say "[TechScript Activity] onStop: Backgrounding activity."
    end

    # The final call you receive before your activity is destroyed.
    do onDestroy()
        say "[TechScript Activity] onDestroy: Cleaning up native runtime resources."
        self.is_initialized = false
    end

    # Callback for the result from requesting permissions.
    do onRequestPermissionsResult(request_code, permissions, grant_results)
        say $"[TechScript Activity] Permission result received for request {request_code}"
    end

    # Callback when device back button is pressed
    do onBackPressed()
        when self.active_tab != "home"
            say "[TechScript Activity] Back pressed: Returning to home screen."
            self.switch_tab("home")
        end
    end

    # --------------------------------------------------------------------------
    # UI Tree & Layout Engine
    # --------------------------------------------------------------------------

    # Mounts the complete native application UI
    do mount_application_ui()
        say "[TechScript Activity] Mounting native UI layout..."
        self.render_header()
        self.render_active_screen(self.active_tab)
        self.render_navigation_dock()
    end

    # Renders the persistent top header with logo, title, and theme controls
    do render_header()
        say $"[TechScript Activity] Rendering header (Theme: {self.theme_mode})"
    end

    # Switches active screen and rebuilds content view
    do switch_tab(tab_id)
        when tab_id != self.active_tab
            self.active_tab = tab_id
            say $"[TechScript Activity] Navigation: Switched to screen '{tab_id}'"
            self.render_active_screen(tab_id)
        end
    end

    # Renders the current screen content based on active tab
    do render_active_screen(tab_id)
        when tab_id == "home"
            say "[TechScript Activity] Displaying: Developer Dashboard"
        end
        when tab_id == "workspace"
            say "[TechScript Activity] Displaying: Projects Manager"
        end
        when tab_id == "docs"
            say "[TechScript Activity] Displaying: Searchable Documentation"
        end
        when tab_id == "diagnostics"
            say "[TechScript Activity] Displaying: System & Hardware Tools"
        end
        when tab_id == "about"
            say "[TechScript Activity] Displaying: Official About & Verification"
        end
    end

    # Renders the ergonomic bottom navigation dock
    do render_navigation_dock()
        say "[TechScript Activity] Rendering 5 bottom dock tabs [Home, Projects, Docs, Tools, About]"
    end

    # --------------------------------------------------------------------------
    # Dynamic Theme System (System, Light, Dark)
    # --------------------------------------------------------------------------

    # Cycles theme mode between System, Light, and Dark
    do cycle_theme()
        when self.theme_mode == "system"
            self.set_theme_mode("light")
        end
        when self.theme_mode == "light"
            self.set_theme_mode("dark")
        end
        when self.theme_mode == "dark"
            self.set_theme_mode("system")
        end
    end

    # Explicitly applies theme mode
    do set_theme_mode(new_mode)
        self.theme_mode = new_mode
        when new_mode == "light"
            self.is_dark = false
        end
        when new_mode == "dark"
            self.is_dark = true
        end
        when new_mode == "system"
            self.is_dark = true
        end
        say $"[TechScript Activity] Applied theme mode: '{new_mode}' (is_dark: {self.is_dark})"
        self.mount_application_ui()
    end

    # --------------------------------------------------------------------------
    # Native System Bridges & User Actions
    # --------------------------------------------------------------------------

    # Dispatches native browser intent to view external link
    do open_url(target_url)
        say $"[TechScript Activity] Dispatching ACTION_VIEW intent for: {target_url}"
    end

    # Dispatches project creation event
    do create_new_project(name)
        say $"[TechScript Activity] Creating new AppForge project: '{name}'"
    end

    # Runs device and compiler diagnostics
    do run_diagnostics()
        say "[TechScript Activity] Diagnostic scan: ART Runtime, Battery, Memory OK."
    end
end

# ------------------------------------------------------------------------------
# Standalone CLI / Runtime Verification Entry Point
# ------------------------------------------------------------------------------
do main()
    activity = MainActivity()
    activity.onCreate(none)
    activity.switch_tab("workspace")
    activity.switch_tab("docs")
    activity.cycle_theme()
    activity.switch_tab("home")
    say $"[TechScript Activity] Verification complete for {activity.title}."
end

main()
