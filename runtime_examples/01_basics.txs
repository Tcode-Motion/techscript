# 1. Basic types and assignment
say "=== Basic Types & Assignment ==="

make my_int = 42
make my_float = 3.14159
keep my_str = "TechScript V2"
make my_bool = true
make nothing = none

say "Int:", my_int
say "Float:", my_float
say "String:", my_str
say "Bool:", my_bool
say "None:", nothing

# Reassignment
my_bool = false
say "Changed Bool:", my_bool

# Compound assignment
my_int += 10
say "42 + 10 =", my_int

# 2. F-strings (String interpolation)
say "=== F-Strings ==="
make greeting = f"Hello from {my_str}! The answer is {my_int}."
say greeting
