# TechScript v1.0.4.3 — Premium Productivity Dashboard
# Run: tech run gui_app.txs

use gui

make win = gui.window("TechFlow Dashboard", 900, 700)
make els = win["elements"]
make styles = win["styles"]
make scripts = win["scripts"]

styles.append("
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap');
  :root { --accent: #4ecdc4; --danger: #ff6b6b; --glass: rgba(255,255,255,0.05); }
  
  body { 
    font-family: 'Outfit', sans-serif; 
    background: radial-gradient(circle at top right, #1a1a2e, #0f0f1a); 
    color: #fff; 
    padding: 3rem; 
    min-height: 100vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .dashboard-header { text-align: center; margin-bottom: 3rem; }
  .dashboard-header h1 { font-size: 3.5rem; margin: 0; background: linear-gradient(135deg, var(--accent), #556270); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 600; letter-spacing: -1.5px; }
  
  .stats-row { display: flex; gap: 20px; margin-bottom: 2rem; width: 600px; }
  .stat-card { flex: 1; background: var(--glass); backdrop-filter: blur(10px); padding: 15px; border-radius: 15px; border: 1px solid rgba(255,255,255,0.1); text-align: center; }
  .stat-card span { display: block; font-size: 0.8rem; text-transform: uppercase; color: #888; }
  .stat-card b { font-size: 1.5rem; color: var(--accent); }

  .input-group { display: flex; gap:10px; width:600px; margin-bottom: 2rem; }
  .gui-input { flex: 1; padding: 15px 25px; border-radius: 15px; border: 1px solid rgba(255,255,255,0.1); background: var(--glass); backdrop-filter: blur(10px); color: #fff; font-size: 1.1rem; outline: none; transition: 0.3s; }
  .gui-input:focus { border-color: var(--accent); box-shadow: 0 0 20px rgba(78, 205, 196, 0.2); }
  
  .gui-btn { padding: 15px 30px; border-radius: 15px; border: none; background: linear-gradient(135deg, var(--danger), #ee5253); color: #fff; font-size: 1rem; font-weight: 600; cursor: pointer; transition: 0.3s ease; box-shadow: 0 10px 20px rgba(238, 82, 83, 0.2); }
  .gui-btn:hover { transform: translateY(-2px); box-shadow: 0 15px 25px rgba(238, 82, 83, 0.3); }
  
  .task-list { width: 600px; animation: fadeIn 0.8s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  
  .task-item { background: rgba(255,255,255,0.03); backdrop-filter: blur(12px); padding: 20px; margin-bottom: 12px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; transition: 0.3s; }
  .task-item:hover { transform: translateX(8px); background: rgba(255,255,255,0.06); }
  .task-content { display: flex; align-items: center; gap: 15px; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  
  .delete-btn { background: transparent; color: var(--danger); border: 1px solid rgba(255,107,107,0.3); padding: 8px 15px; border-radius: 10px; cursor: pointer; transition: 0.2s; }
  .delete-btn:hover { background: var(--danger); color: #fff; }
")

els.append("<div class='dashboard-header'><h1>TechFlow</h1><p>Productivity Redefined</p></div>")

els.append("<div class='stats-row'>
  <div class='stat-card'><span>Total</span><b id='totalCount'>2</b></div>
  <div class='stat-card'><span>Pending</span><b id='pendingCount'>2</b></div>
  <div class='stat-card'><span>Uptime</span><b>99.9%</b></div>
</div>")

els.append("<div class='input-group'>
    <input type='text' id='taskInput' class='gui-input' placeholder='Capture a new idea...' />
    <button class='gui-btn' onclick='addTask()'>Add Task</button>
</div>")

els.append("<div id='taskList' class='task-list'>
    <div class='task-item'><div class='task-content'><div class='status-dot'></div><span>Launch TechScript v1.0.4.3</span></div> <button class='delete-btn' onclick='removeTask(this)'>Done</button></div>
    <div class='task-item'><div class='task-content'><div class='status-dot'></div><span>Ship Premium Examples</span></div> <button class='delete-btn' onclick='removeTask(this)'>Done</button></div>
</div>")

scripts.append("
  function updateStats() {
      const count = document.getElementById('taskList').children.length;
      document.getElementById('totalCount').innerText = count;
      document.getElementById('pendingCount').innerText = count;
  }

  function addTask() {
      const input = document.getElementById('taskInput');
      const val = input.value.trim();
      if (!val) return;
      
      const list = document.getElementById('taskList');
      const div = document.createElement('div');
      div.className = 'task-item';
      div.innerHTML = `<div class='task-content'><div class='status-dot'></div><span>${val}</span></div> <button class='delete-btn' onclick='removeTask(this)'>Done</button>`;
      
      list.appendChild(div);
      input.value = '';
      updateStats();
  }

  function removeTask(btn) {
      btn.parentElement.style.opacity = '0';
      btn.parentElement.style.transform = 'scale(0.9)';
      setTimeout(() => {
          btn.parentElement.remove();
          updateStats();
      }, 300);
  }

  document.getElementById('taskInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') addTask();
  });
")

say "🚀 Launching TechFlow Productivity Dashboard (blocking server)..."
gui.show(win)
