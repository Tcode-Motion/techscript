// TechScript AppForge: Official Design Tokens & Liquid Glass Palette
// Authored in 100% Pure TechScript (.txs)

do get_theme_tokens()
    send {
        "app_name": "TechScript AppForge",
        "version": "2.0.0",
        "creator": "Tanmoy Majumder",
        "github": "Tcode-Motion",
        "website": "https://techscript.is-a.dev/techscript/",
        "repository": "https://github.com/Tcode-Motion/techscript",
        "contact_email": "majumdertanmoy510@gmail.com",
        "fonts": {
            "primary": "Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
            "mono": "'JetBrains Mono', monospace"
        },
        "glass": {
            "dark_surface": "rgba(17, 24, 39, 0.72)",
            "dark_border": "rgba(255, 255, 255, 0.08)",
            "dark_blur": "blur(16px)",
            "light_surface": "rgba(255, 255, 255, 0.82)",
            "light_border": "rgba(0, 0, 0, 0.06)",
            "light_blur": "blur(16px)",
            "spring_physics": "cubic-bezier(0.34, 1.56, 0.64, 1)"
        },
        "colors": {
            "primary": "#4f46e5",
            "primary_hover": "#4338ca",
            "accent": "#06b6d4",
            "success": "#10b981",
            "warning": "#f59e0b",
            "error": "#ef4444"
        }
    }
end

do main()
    tokens = get_theme_tokens()
    say "[Theme] Initialized tokens for: " + tokens["app_name"] + " v" + tokens["version"]
end
