# compat/01_keywords.txs — v1.0.8 keyword aliases
# Every line here uses a v1.0.8 keyword; the 2.0 equivalents are in comments.

# `keep` = const
keep LIMIT be 5           # const LIMIT = 5

# `make` variable + `be` assignment
make counter be 0         # let counter = 0

# `give` = return  (inside a function)
build double with x then
  give x * 2
end

# `each` = for
each i in 1..3 then
  say i
end

# `when` = if
when counter equals 0 then
  say "counter is zero"
end

# `typeof` operator
say typeof "hello"        # should print: str
say typeof 42             # should print: int
say typeof {}             # should print: dict
say typeof []             # should print: list
say typeof true           # should print: bool

# call double
say double(4)             # should print: 8
